# ==============================================================================
# ImanTap Backend (Telegram Bot + HTTP API) — Environment Variables Contract
# Copy this file to `.env` and fill in your real values.
# ==============================================================================

# --- Required ---
# Telegram Bot API token from @BotFather
BOT_TOKEN=

# MongoDB connection URI (код также поддерживает MONGO_URI или MONGODB_URI)
MONGO_URL=mongodb://localhost:27017

# Telegram user ID главного администратора (число)
MAIN_ADMIN_ID=

# --- Functional (payments & Telegram Mini App links) ---
# Ссылка на оплату Kaspi Pay
KASPI_LINK=

# Публичный URL фронтенда Telegram Mini App (HTTPS)
MINI_APP_URL=https://your-mini-app-domain.example.com

# Username Telegram-бота без символа '@' (фолбэк в коде: imantap_bot)
BOT_USERNAME=imantap_bot

# Short name Mini App из @BotFather для диплинков https://t.me/<BOT_USERNAME>/<MINI_APP_NAME>
# Если не задано, диплинки безопасно откатываются на https://t.me/<BOT_USERNAME>
MINI_APP_NAME=

# --- Optional / Runtime configuration ---
# Порт HTTP API сервера (по умолчанию 8080)
PORT=8080

# Имя базы данных MongoDB (по умолчанию imantap_db)
DB_NAME=imantap_db

# Окружение: development | production
NODE_ENV=development

# Максимальный возраст Telegram initData в секундах (по умолчанию 86400 = 24ч)
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
